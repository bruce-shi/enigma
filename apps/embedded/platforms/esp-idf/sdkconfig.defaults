# Lichuang ESP32-S3 board: ESP32-S3-WROOM-1-N16R8.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
# esp-idf-sys evaluates this from target/<triple>/<profile>/build/<hash>/out.
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../../../../../../partitions.csv"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# The N16R8 module has 8 MiB octal PSRAM.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y

# Rust and the Apple protocol stack need more main-task stack than the C default.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=32768
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=4096
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=8192

# Serve the iPhone location portal over both captive HTTP onboarding and HTTPS.
CONFIG_ESP_HTTPS_SERVER_ENABLE=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
# Advertise the board as DNS through the SoftAP DHCP lease. The firmware keeps
# enigma.test local and forwards other queries after upstream Wi-Fi connects.
CONFIG_LWIP_DHCPS_ADD_DNS=y
# The captive HTTP/HTTPS portal, DNS relay, mDNS discovery, Safari keep-alive
# sessions, and the two-stage CoreDevice tunnel coexist during a location set.
# ESP-IDF's default of 10 sockets can be exhausted before pairing connects.
CONFIG_LWIP_MAX_SOCKETS=24
# Route IPv4 traffic from Enigma-XXXX through the board's upstream station.
CONFIG_LWIP_IP_FORWARD=y
CONFIG_LWIP_IPV4_NAPT=y

# Match the known-good board definition in xiaozhi-esp32.
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=1536
CONFIG_USB_HOST_ENABLE_ENUM_FILTER_CALLBACK=y
CONFIG_USB_HOST_HUBS_SUPPORTED=y
