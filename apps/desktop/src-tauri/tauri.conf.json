{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Enigma",
  "version": "0.0.0",
  "identifier": "app.enigma.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://api.enigma.example https://maps.enigma.example; img-src 'self' asset: http://asset.localhost blob: data: https://maps.enigma.example; style-src 'self' 'unsafe-inline'; font-src 'self' data: https://maps.enigma.example; worker-src 'self' blob:; frame-src 'none'; object-src 'none'; base-uri 'none'"
    },
    "windows": [
      {
        "title": "Enigma",
        "width": 1440,
        "height": 900,
        "minWidth": 1040,
        "minHeight": 680,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": [],
    "targets": ["dmg", "nsis"],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["enigma"]
      }
    },
    "updater": {
      "endpoints": ["https://releases.enigma.example/updater/stable/latest.json"],
      "pubkey": "REPLACE_WITH_TAURI_UPDATER_PUBLIC_KEY"
    }
  }
}
