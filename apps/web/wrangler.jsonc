{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "enigma-web",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    "PUBLIC_ORIGIN": "http://localhost:5173",
    "EMAIL_FROM": "Enigma <signin@enigma.example>",
    "STRIPE_MONTHLY_PRICE_ID": "price_replace_monthly",
    "STRIPE_YEARLY_PRICE_ID": "price_replace_yearly",
    "PUBLIC_RELEASE_STATUS": "development",
    "PUBLIC_RELEASE_VERSION": "0.0.0",
    "PUBLIC_SUPPORTED_IOS_BUILDS": "",
    "PUBLIC_BILLING_ENABLED": "false",
    "PUBLIC_MONTHLY_PRICE_LABEL": "Not configured",
    "PUBLIC_YEARLY_PRICE_LABEL": "Not configured",
    "PUBLIC_MACOS_ARM64_DOWNLOAD_URL": "",
    "PUBLIC_MACOS_X64_DOWNLOAD_URL": "",
    "PUBLIC_WINDOWS_X64_DOWNLOAD_URL": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "enigma-accounts",
      "database_id": "replace-with-d1-database-id",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "CRASH_REPORTS",
      "bucket_name": "enigma-crash-reports"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["signin@enigma.example"]
    }
  ]
}
