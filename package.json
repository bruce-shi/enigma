{
  "name": "enigma",
  "version": "0.1.0",
  "license": "GPL-3.0-only",
  "private": true,
  "packageManager": "bun@1.3.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run check",
    "dev": "turbo run dev --parallel",
    "lint": "biome check .",
    "test": "turbo run test",
    "test:run": "node --test scripts/*.test.mjs && turbo run test:run",
    "desktop": "bun --filter @enigma/desktop",
    "web": "bun --filter @enigma/web",
    "release:version": "node scripts/verify-release-version.mjs",
    "release:check": "bun run release:version && bun --filter @enigma/desktop release:check",
    "release:check:production": "bun run release:version && bun --filter @enigma/desktop release:check:production"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@types/node": "24.3.1",
    "turbo": "2.10.11",
    "typescript": "5.9.2"
  },
  "trustedDependencies": [
    "esbuild",
    "workerd"
  ],
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@heroui/react": "3.2.4",
      "@heroui/styles": "3.2.4",
      "@types/react": "19.1.12",
      "@types/react-dom": "19.1.9",
      "react": "19.2.8",
      "react-dom": "19.2.8",
      "tailwindcss": "4.3.3",
      "typescript": "5.9.2",
      "vite": "8.2.1",
      "vitest": "3.2.4"
    }
  }
}
